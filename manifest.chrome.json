{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "0.1.0",
  "description": "Firefox-first bookmark manager extension.",
  "permissions": ["bookmarks", "storage", "alarms", "tabs"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bookmark Manager",
    "default_popup": "popup.html"
  },
  "commands": {
    "open-quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open quick bookmark search"
    }
  },
  "options_page": "options.html"
}

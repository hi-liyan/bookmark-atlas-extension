{
  "manifest_version": 3,
  "name": "Bookmark Atlas",
  "version": "0.1.0",
  "description": "Firefox-first bookmark atlas extension.",
  "icons": {
    "512": "icons/icon512.png"
  },
  "permissions": ["bookmarks", "storage", "alarms", "tabs"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bookmark Atlas",
    "default_popup": "popup.html",
    "default_icon": "icons/icon512.png"
  },
  "commands": {
    "open-quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open quick bookmark search"
    }
  },
  "options_page": "options.html"
}

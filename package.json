{
  "name": "bookmark-atlas-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:firefox",
    "build:firefox": "vite build && node scripts/copy-manifest.mjs firefox",
    "build:chrome": "vite build && node scripts/copy-manifest.mjs chrome",
    "package": "node scripts/package-extension.mjs",
    "package:firefox": "node scripts/package-extension.mjs --platform=firefox",
    "package:chrome": "node scripts/package-extension.mjs --platform=chrome",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.50",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "yazl": "^3.3.1"
  }
}
